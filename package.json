{
  "name": "violet-game",
  "version": "1.0.0",
  "description": "Violet: a black pug puzzle maze game built with Phaser 3, Tone.js and TypeScript",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\" index.html",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run format && npm run lint && npm run typecheck && npm run test"
  },
  "keywords": [
    "game",
    "phaser",
    "puzzle",
    "pug"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.10.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
